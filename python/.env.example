# Thesis Tracker — Python SDK configuration.
# Copy to .env and fill in (this file is safe to commit; .env is git-ignored).
# Auth: personal access token from Settings → Python SDK access tokens (shown once on create).
# Format: tt_<random> — never commit real tokens.
# The SDK talks to your web app instance (default http://localhost:3000).

THESIS_TRACKER_TOKEN=tt_your_token_here
THESIS_TRACKER_API_URL=http://localhost:3000

# Scope runs to a project so they show under it in the dashboard.
# Use the name (resolved at connect time) OR the explicit id:
THESIS_TRACKER_PROJECT=My Thesis
# THESIS_TRACKER_PROJECT_ID=00000000-0000-0000-0000-000000000000
