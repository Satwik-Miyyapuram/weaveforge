# Copy to test-accounts.env in this folder. local-dev/ is gitignored — do not commit passwords.
TEST_ACCOUNT_PASSWORD=change-me-locally

# Primary SDK / demo / live-run account (must exist after seed-test-users)
TEST_ACCOUNT_EMAIL_PRIMARY=c@example.com

# Playwright e2e (optional — defaults to TEST_ACCOUNT_PASSWORD)
E2E_TEST_PASSWORD=
THESIS_TRACKER_EMAIL=
THESIS_TRACKER_PASSWORD=
THESIS_TRACKER_B_EMAIL=b@example.com
THESIS_TRACKER_B_PASSWORD=

# Demo clip recorder (optional)
DEMO_CLIP_EMAIL=c@example.com
DEMO_CLIP_PASSWORD=
