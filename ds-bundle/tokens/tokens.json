{
  "$comment": "WeaveForge foundations — default light theme. Machine-readable mirror of tokens/light.css. Values that reference other tokens use var(--x).",
  "color": {
    "core": {
      "bg": "#f6f4ef",
      "surface": "#fffdf8",
      "ink": "#2c2a26",
      "muted": "#6f6a60",
      "line": "#e7e2d8",
      "accent": "#7c9885",
      "accent-ink": "#46594d",
      "clay": "#c98a6b",
      "danger": "#b4513b"
    },
    "surface": {
      "input-bg": "#ffffff",
      "pill": "#f1eee7",
      "hover": "#e9efe9",
      "chip": "#f3f1ea",
      "neutral": "#efece4",
      "status-neutral": "#efece4",
      "nav-bg": "rgba(255, 253, 248, 0.9)",
      "active-bg": "#d9e6dc"
    },
    "status": {
      "neutral": { "bg": "var(--neutral)", "fg": "var(--muted)" },
      "positive": { "bg": "#e6efe9", "fg": "var(--accent-ink)" },
      "info": { "bg": "#e7eef7", "fg": "#3e5a78" },
      "warn": { "bg": "#f7efe6", "fg": "#8a6a4e" },
      "danger": { "bg": "#f7e9e6", "fg": "#b4513b" }
    },
    "graph": {
      "node-default": "var(--neutral)",
      "node-reading": "var(--accent)",
      "node-read": "#5a7d8c",
      "node-skimmed": "var(--clay)"
    }
  },
  "radius": { "radius": "16px", "radius-sm": "10px" },
  "typography": {
    "font": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Inter, sans-serif"
  },
  "elevation": {
    "shadow": "0 2px 8px rgba(44,42,38,.08), 0 16px 32px rgba(44,42,38,.14), inset 0 1px 0 rgba(255,255,255,.8), inset 0 0 0 1px rgba(255,255,255,.4)"
  }
}
