{
  "name": "@weaveforge/core",
  "version": "0.5.2",
  "description": "Shared, framework-agnostic domain contracts and types for WeaveForge.",
  "license": "AGPL-3.0-only",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Satwik-Miyyapuram/weaveforge.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Satwik-Miyyapuram/weaveforge/issues"
  },
  "homepage": "https://github.com/Satwik-Miyyapuram/weaveforge#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./org-crypto": {
      "types": "./dist/features/org/domain/invite-code-crypto.d.ts",
      "default": "./dist/features/org/domain/invite-code-crypto.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
