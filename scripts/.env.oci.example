# Copy to the repo root as .env.oci. Every line is optional — the retry script
# discovers what it can and only stops if a lookup is ambiguous.
#
# These are OCIDs: identifiers, not credentials. Your actual OCI credentials
# live in ~/.oci/config and never appear here.

# Where to build. Console → Identity → Compartments.
# COMPARTMENT_ID=ocid1.compartment.oc1..xxxxx

# Console → Networking → VCN → Subnets. The public one.
# SUBNET_ID=ocid1.subnet.oc1.eu-amsterdam-1.xxxxx

# Leave unset to take the newest Ubuntu aarch64 image the shape can boot.
# IMAGE_ID=ocid1.image.oc1.eu-amsterdam-1.xxxxx

# Single-AD regions have exactly one; unset picks it.
# AVAILABILITY_DOMAIN=gaak:EU-AMSTERDAM-1-AD-1

DISPLAY_NAME=weaveforge
BOOT_VOLUME_GB=50
SSH_KEY_FILE=~/.ssh/oci_weaveforge.pub

# Sizes to try, largest first, "ocpus:memory_gb". A smaller shape fits gaps a
# larger one cannot, so the ladder gets you a machine sooner.
# Always Free is 2 OCPUs / 12 GB total since 15 June 2026 — going above bills you.
SHAPE_LADDER=2:12 1:6

INTERVAL=90
MAX_HOURS=12
