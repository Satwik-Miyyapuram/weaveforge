{
  "name": "weaveforge",
  "version": "0.5.2",
  "private": true,
  "description": "Open-source, modular tracker for a masters thesis (papers, experiments, logbook, report, meetings).",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Satwik-Miyyapuram/weaveforge.git"
  },
  "bugs": {
    "url": "https://github.com/Satwik-Miyyapuram/weaveforge/issues"
  },
  "homepage": "https://github.com/Satwik-Miyyapuram/weaveforge#readme",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "//": "Node 22+ for a global WebSocket. supabase-js constructs a realtime client on createClient, and on Node 20 that throws before any query runs.",
    "node": ">=22"
  },
  "scripts": {
    "build:core": "npm run build --workspace @weaveforge/core",
    "test:core": "npm run test --workspace @weaveforge/core",
    "test:web": "npm run test --workspace @weaveforge/web",
    "lint": "npm run lint --workspace @weaveforge/web",
    "test:integration:web": "npm run test:integration --workspace @weaveforge/web",
    "test:e2e": "npm run test:e2e --workspace @weaveforge/web",
    "test:e2e:editor": "npm run test:e2e:editor --workspace @weaveforge/web",
    "record:demos": "npm run record:demos --workspace @weaveforge/web",
    "seed:showcase": "node scripts/seed-showcase-data.mjs",
    "setup:local-dev": "node scripts/setup-local-dev.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:solid": "node scripts/check-solid.mjs",
    "check:dry": "node scripts/check-dry.mjs",
    "check:api-route-tests": "node scripts/check-api-route-tests.mjs",
    "check:ui": "node scripts/check-ui-consistency.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "check:mcp-plugin": "node scripts/check-mcp-plugin.mjs",
    "check:boundaries": "npm run check:solid && npm run check:dry && npm run check:api-route-tests && npm run check:ui && npm run check:hygiene && npm run check:mcp-plugin",
    "check:all": "npm run typecheck && npm run lint && npm run check:boundaries && npm run test:core && npm run test:web && npm run test:integration:web && npm run test:desktop && npm run build",
    "generate:routes": "node scripts/generate-module-routes.mjs",
    "generate:deployment": "node --import tsx scripts/generate-deployment-registry.mjs",
    "check:deployment-surface": "node --import tsx scripts/check-deployment-surface.mjs",
    "prebuild": "npm run generate:deployment",
    "build": "npm run build --workspace @weaveforge/web",
    "dev": "npm run dev --workspace @weaveforge/web",
    "serve": "npm run serve --workspace @weaveforge/web",
    "start": "npm run start --workspace @weaveforge/web",
    "migrate:ping": "node scripts/ping-target.mjs",
    "migrate:preflight": "node scripts/migration-preflight.mjs",
    "migrate:schema": "node scripts/apply-migrations-oci.mjs",
    "migrate:data": "node scripts/migrate-supabase-to-postgres.mjs",
    "migrate:blobs": "node scripts/migrate-blobs.mjs",
    "migrate:verify": "node scripts/verify-migration.mjs",
    "migrate": "node scripts/migrate-to-oracle.mjs",
    "test:desktop": "npm run test --workspace @weaveforge/desktop",
    "build:desktop": "npm run build --workspace @weaveforge/desktop"
  },
  "devDependencies": {
    "supabase": "^2.109.1"
  }
}
