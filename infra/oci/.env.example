# WeaveForge OCI stack — copy to .env beside docker-compose.yml on the VM.
#
#   cp .env.example .env && nano .env
#
# Nothing here is read by the app; it configures the containers.

# ---------------------------------------------------------------- Postgres
POSTGRES_USER=weaveforge
POSTGRES_PASSWORD=
POSTGRES_DB=weaveforge
# Subdirectory of the block volume, not its mount point: an ext4 root holds
# lost+found and initdb refuses a non-empty data directory.
PGDATA_HOST=/mnt/pgdata/data

# ------------------------------------------------------- Supabase Auth link
# The secret Supabase signs its JWTs with (Dashboard → Settings → API → JWT).
# PostgREST and Realtime both validate against it, which is what lets a token
# issued by Supabase Auth authenticate against services running here.
SUPABASE_JWT_SECRET=

# The keys PostgREST verifies tokens with, as a JWK Set.
#
# Not the same thing as the secret above. Supabase projects now sign session
# tokens with an asymmetric key (ES256, listed at
# <project>/auth/v1/.well-known/jwks.json) while the legacy anon/service_role
# keys stay HS256. PostgREST needs both, or signed-in users get PGRST301 while
# server-side calls keep working — a split that looks like an app bug.
#
# Build it by taking the project's JWKS and appending an `oct` entry whose `k`
# is the base64url of SUPABASE_JWT_SECRET.
JWT_KEYS=

# Comma-separated origins allowed to call the data API. Leave as * only while
# testing; set it to the app's origin before the cutover is public.
CORS_ALLOWED_ORIGINS=*

# ---------------------------------------------------------------- Realtime
# Exactly 16 characters — Realtime encrypts tenant records with it and refuses
# to boot otherwise.
REALTIME_DB_ENC_KEY=
# 64+ characters. `openssl rand -base64 48` is fine.
REALTIME_SECRET_KEY_BASE=

# Leave unset (true) for the first boot so the `realtime-dev` tenant is created,
# then set to false. The seed rewrites the tenant row on every start and nulls
# `jwt_jwks`, which is where the project's ES256 public keys live — leaving it
# on means user tokens stop verifying after any restart.
REALTIME_SEED_SELF_HOST=false

# ------------------------------------------------------------------ Gateway
# No variables. The gateway listens on 127.0.0.1:8080 and routes /realtime/v1
# to Realtime, everything else to PostgREST. TLS and the public hostname come
# from Cloudflare Tunnel (/etc/cloudflared/config.yml), so point that ingress
# at localhost:8080 rather than at PostgREST directly.

# ------------------------------------------------------------------- MinIO
MINIO_ROOT_USER=weaveforgeminio
MINIO_ROOT_PASSWORD=
MINIO_DATA_HOST=/mnt/minio/data
