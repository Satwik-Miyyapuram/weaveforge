# Copy to .env on the OCI VM (never commit .env)
POSTGRES_USER=thesis
POSTGRES_PASSWORD=change-me-long-random-string
POSTGRES_DB=thesis

# PostgREST validates the tokens Supabase Auth issues, so it needs the same
# secret. Supabase dashboard → Project Settings → API → JWT Settings → JWT Secret.
# Without it the data API rejects every request as unauthenticated.
SUPABASE_JWT_SECRET=change-me-copy-from-supabase

# Origins allowed to call the data API. Set this to your real domain before
# anything but you uses it; `*` is fine while the box is a shadow environment.
CORS_ALLOWED_ORIGINS=*

MINIO_ROOT_USER=thesisminio
MINIO_ROOT_PASSWORD=change-me-long-random-string

# Host paths for block volumes (default OCI layout from oci-phase3-setup.md)
PGDATA_HOST=/mnt/pgdata
MINIO_DATA_HOST=/mnt/minio
