# WeaveForge — the URL shapes supabase-js builds, on one hostname.
#
# `createClient(url, key)` derives every endpoint from a single base URL:
#
#     REST      ${url}/rest/v1/<table>
#     Realtime  ${url}/realtime/v1/websocket
#
# Supabase serves both through Kong. This does the same routing so the browser
# can point NEXT_PUBLIC_DATA_URL and NEXT_PUBLIC_REALTIME_URL at one host.
#
# No TLS here on purpose: Cloudflare Tunnel terminates TLS at the edge and
# forwards to this process over loopback, so the VM keeps every service port
# closed to the internet. That is also why this listens on 127.0.0.1 — nothing
# outside the box may reach it directly.

{
	# Cloudflare owns the certificate; a second ACME client here would fight it
	# for the same hostname and fail, since 80/443 are not open to the internet.
	auto_https off
}

:8080 {
	encode zstd gzip

	# CORS, answered here rather than by PostgREST.
	#
	# PostgREST's preflight reply carries an allow-origin but no
	# `Access-Control-Allow-Headers`, so a browser strips `Authorization` from
	# the real request and every call arrives anonymous — which surfaces as a
	# CORS error, not an auth error, and sends you looking in the wrong place.
	#
	# The origin is matched against an allowlist rather than echoed back. Echoing
	# whatever asks makes the check decorative: any page anywhere could then read
	# a signed-in user's data with a token it had obtained. These are the app's
	# own origins, plus localhost for development.
	#
	# `Max-Age` matters more than it looks: without it a preflight is cached for
	# seconds, and each distinct query URL pays a second round trip. A day is the
	# most Chrome honours.
	@allowed_origin header_regexp Origin ^https://(www\.)?weaveforge\.org$|^http://localhost:(3000|3100)$

	@preflight_allowed {
		method OPTIONS
		header_regexp Origin ^https://(www\.)?weaveforge\.org$|^http://localhost:(3000|3100)$
	}
	handle @preflight_allowed {
		header {
			Access-Control-Allow-Origin "{header.Origin}"
			Access-Control-Allow-Methods "GET, POST, PATCH, PUT, DELETE, HEAD, OPTIONS"
			# The set supabase-js sends: auth, the anon key, PostgREST's own
			# `Prefer`/profile negotiation, and range headers for pagination.
			Access-Control-Allow-Headers "authorization, apikey, content-type, prefer, range, x-client-info, accept-profile, content-profile, x-supabase-api-version"
			Access-Control-Max-Age "86400"
			Vary "Origin"
			defer
		}
		respond 204
	}

	# An unlisted origin gets no allow-origin header, which is what makes the
	# browser refuse the request.
	@preflight_other method OPTIONS
	handle @preflight_other {
		respond 403
	}

	# The same origin header on real responses, plus the headers PostgREST uses
	# to report pagination — invisible to JS unless explicitly exposed.
	header @allowed_origin {
		Access-Control-Allow-Origin "{header.Origin}"
		Access-Control-Expose-Headers "content-range, content-location, range-unit"
		Vary "Origin"
		defer
	}

	# Realtime first: the more specific prefix, and the websocket upgrade has to
	# reach the path the server actually listens on.
	handle_path /realtime/v1/* {
		# Two rewrites, both required:
		#
		# 1. Path. Realtime is a Phoenix app mounted at `/socket`; the client asks
		#    for `/realtime/v1/websocket`. `handle_path` strips the prefix, and
		#    this puts the socket mount back on the front.
		# 2. Host. Realtime is multi-tenant and reads the tenant from the first
		#    label of the Host header. `SEED_SELF_HOST` creates one tenant named
		#    `realtime-dev`, so the upstream request has to arrive claiming that
		#    name — passing the real host through gets every connection rejected
		#    as an unknown tenant.
		rewrite * /socket{uri}
		reverse_proxy realtime:4000 {
			header_up Host realtime-dev.localhost
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
		}
	}

	# PostgREST serves tables at its root, which is why the app's data URL drops
	# `/rest/v1`. Both shapes work: `handle_path` strips the prefix for a client
	# that sends it, and the fallback below serves the bare table paths the app
	# actually uses — so pointing the tunnel here does not change any URL that
	# already worked.
	handle_path /rest/v1/* {
		reverse_proxy postgrest:3000
	}

	handle {
		reverse_proxy postgrest:3000
	}
}
