<?xml version="1.0" encoding="utf-8"?>
<!-- The card: a hard offset shadow under a bordered face, as in the app. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_shadow" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_bg" />
            <stroke android:width="2dp" android:color="@color/widget_line" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>
