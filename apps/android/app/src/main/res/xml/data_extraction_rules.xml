<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the phone in a backup or a device-to-device transfer: the
    WebView's storage holds the session tokens. allowBackup="false" stops cloud
    backup; on Android 12+ these rules also stop the device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
