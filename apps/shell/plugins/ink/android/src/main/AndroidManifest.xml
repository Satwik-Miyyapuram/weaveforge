<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The deadlines widget, as in apps/android. Exported so the launcher can send it updates. -->
        <receiver
            android:name="org.weaveforge.ink.PlanWidgetProvider"
            android:exported="true"
            android:label="@string/plan_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/plan_widget_info" />
        </receiver>
        <activity
            android:name="org.weaveforge.ink.PlanWidgetConfigActivity"
            android:exported="true"
            android:label="@string/plan_widget_setup_title"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>
    </application>
</manifest>
