{
  "name": "@weaveforge/desktop",
  "version": "0.5.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Electron shell around the WeaveForge web app: the same UI, plus what only a desktop can do.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prestart": "npm run build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/build.mjs && electron-builder",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "node scripts/build.mjs && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@weaveforge/core": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^33.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.0",
    "tsx": "^4.23.0"
  },
  "build": {
    "appId": "dev.weaveforge.desktop",
    "productName": "WeaveForge",
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
