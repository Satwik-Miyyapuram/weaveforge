{
  "name": "@weaveforge/desktop",
  "version": "0.5.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Electron shell around the WeaveForge web app: the same UI, plus what only a desktop can do.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prestart": "npm run build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/build-web.mjs",
    "package": "node scripts/build.mjs && node scripts/build-web.mjs && electron-builder",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "node scripts/build.mjs && node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@weaveforge/core": "*",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.0",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "dev.weaveforge.desktop",
    "productName": "WeaveForge",
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Satwik-Miyyapuram",
        "repo": "weaveforge"
      }
    ]
  },
  "author": "WeaveForge",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "electron-updater": "^6.8.9"
  }
}
