{
  "name": "@weaveforge/desktop",
  "version": "0.6.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Electron shell around the WeaveForge web app: the same UI, plus what only a desktop can do.",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prestart": "npm run build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "build:web": "node scripts/build-web.mjs",
    "package": "node scripts/build.mjs && node scripts/build-web.mjs && npm run build:ink && electron-builder",
    "test": "node --import tsx --test test/*.test.ts",
    "build:ink": "node scripts/build-ink-recogniser.mjs",
    "smoke": "node scripts/build.mjs && node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@weaveforge/core": "*",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "resedit": "^1.7.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "dev.weaveforge.desktop",
    "productName": "WeaveForge",
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/ink-recogniser/${os}-${arch}",
        "to": "native/ink-recogniser/${os}-${arch}"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "installer/sidebar.bmp",
      "uninstallerSidebar": "installer/sidebar.bmp",
      "installerHeader": "installer/header.bmp",
      "shortcutName": "WeaveForge"
    },
    "npmRebuild": false,
    "publish": [
      {
        "provider": "github",
        "owner": "Satwik-Miyyapuram",
        "repo": "weaveforge"
      }
    ],
    "afterPack": "scripts/stamp-exe.cjs"
  },
  "author": "WeaveForge",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "electron-updater": "^6.8.9"
  }
}
