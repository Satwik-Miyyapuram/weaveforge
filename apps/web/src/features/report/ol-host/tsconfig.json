{
  // The Overleaf IDE (the third_party/overleaf submodule) is checked here, with
  // Overleaf's own strictness, together with the host and shims around it. The
  // web app sees it only through ol-host's typed entry (see apps/web/tsconfig.json
  // "paths").
  "extends": "../../../../../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": false,
    "allowImportingTsExtensions": true,
    "lib": ["ES2024", "ESNext.Iterator", "DOM", "DOM.Iterable", "DOM.AsyncIterable", "WebWorker"],
    // Overleaf's roots and pinned versions, for this tree only (next.config.mjs
    // does the same for the bundle). The app keeps its own pdfjs-dist 4.
    "paths": {
      "@/*": ["../../../../../../third_party/overleaf/services/web/frontend/js/*"],
      "@ol-types/*": ["../../../../../../third_party/overleaf/services/web/types/*"],
      "pdfjs-dist": ["../../../../node_modules/pdfjs-dist-overleaf", "../../../../../../node_modules/pdfjs-dist-overleaf"],
      "pdfjs-dist/*": ["../../../../node_modules/pdfjs-dist-overleaf/*", "../../../../../../node_modules/pdfjs-dist-overleaf/*"],
      "@replit/codemirror-vim": ["../ol-shims/codemirror-vim.d.ts"]
    }
  },
  "include": [
    "../../../../../../third_party/overleaf/services/web/frontend",
    "../../../../../../third_party/overleaf/services/web/types",
    "../../../../../../third_party/overleaf/libraries",
    ".",
    "../ol-shims"
  ],
  "exclude": ["node_modules"]
}
