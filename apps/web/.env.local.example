# Copy to .env.local and fill in from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ------------------------------------------------- self-hosting the backend
# Both unset means "everything on Supabase", which is the default and needs no
# further setup. They are set together at cutover: data and the realtime
# authorization that reads it have to agree on which database is current.
#
# The data API. A self-hosted PostgREST speaks the same protocol as Supabase's
# REST endpoint, so this is an address change and nothing more. Auth stays on
# NEXT_PUBLIC_SUPABASE_URL — the tokens are Supabase's to issue, and PostgREST
# validates them with the shared JWT secret.
# NEXT_PUBLIC_DATA_URL=https://api.example.org
#
# The realtime service (co-editing, cache invalidation). Must move with the
# data: private broadcast channels are authorized by RLS policies that read
# `vault_pages`, `papers` and `shares`, so a Supabase-hosted realtime would be
# judging against a frozen copy and would refuse every document created after
# the cutover — silently, with the editor simply not converging.
# NEXT_PUBLIC_REALTIME_URL=https://api.example.org

# Server-only. Required for **creating/joining labs** and privileged account
# provisioning (People → Create account). NOT required for "Continue standalone"
# or normal app use — only the anon key above is enough for solo mode.
# NEVER expose this to the browser — it must NOT be prefixed with NEXT_PUBLIC_.
# Find it under Supabase → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Server-only. Required for Python SDK personal access tokens (Settings → API tokens).
# Supabase → Project Settings → API → JWT Settings → JWT Secret.
SUPABASE_JWT_SECRET=YOUR-JWT-SECRET

# Server-only. Required for linked Overleaf reports. Use a long random value
# and keep it stable across deploys so saved Overleaf tokens remain decryptable.
# It is never sent to the browser, MCP, or logs.
OVERLEAF_CREDENTIAL_KEY=YOUR-LONG-RANDOM-SERVER-KEY

# --- Backend provider (optional; default: supabase) ---
# NEXT_PUBLIC_BACKEND_PROVIDER=supabase          # supabase | postgres
# DATABASE_URL=postgres://...                    # when provider = postgres (future)

# --- Blob storage (optional; default: supabase) ---
# See docs/storage/README.md
# NEXT_PUBLIC_BLOB_PROVIDER=supabase             # supabase | tiered (client + server)
# BLOB_PROVIDER=supabase                           # server-only alias for NEXT_PUBLIC_BLOB_PROVIDER
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=weaveforge-hot
# BLOB_VIEW_SECRET=                             # optional; defaults to service role key or R2 secret
# --- OCI Phase 3 (Postgres + MinIO cold tier) — see docs/backend/oci-phase3-setup.md ---
# DATABASE_URL=postgres://thesis:...@YOUR_OCI_IP:5432/thesis
# BLOB_COLD_ENDPOINT=http://YOUR_OCI_IP:9000
# BLOB_COLD_ACCESS_KEY_ID=
# BLOB_COLD_SECRET_ACCESS_KEY=
# BLOB_COLD_BUCKET=weaveforge-cold

# --- Integration providers (optional; defaults shown) ---
# User/project API tokens are entered in-app (Settings), not here.
# See docs/integrations.md for adding new providers.

# NEXT_PUBLIC_BIBLIOGRAPHY_PROVIDER=zotero          # zotero | none
# NEXT_PUBLIC_NOTIFICATION_PROVIDER=mattermost      # mattermost | none
# NEXT_PUBLIC_LOG_SYNC_PROVIDER=gitlab              # gitlab | none
# NEXT_PUBLIC_CITATION_PROVIDER=semantic-scholar    # semantic-scholar | none
# NEXT_PUBLIC_GIT_READ_PROVIDERS=github,gitlab      # comma-separated | none
