{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "incremental": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@weaveforge/core": [
        "../../packages/core/src/index.ts"
      ],
      "@weaveforge/core/testing": [
        "../../packages/core/src/testing/index.ts"
      ],
      "@overleaf-ide": [
        "./src/features/report/vendor/overleaf/ol-host/api.d.ts"
      ]
    },
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*",
    "../../weaveforge.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "public/sw.js",
    "public/swe-worker*",
    "src/features/report/vendor/overleaf/app",
    "src/features/report/vendor/overleaf/codemirror",
    "src/features/report/vendor/overleaf/frontend",
    "src/features/report/vendor/overleaf/libraries",
    "src/features/report/vendor/overleaf/ol-host",
    "src/features/report/vendor/overleaf/ol-shims",
    "src/features/report/vendor/overleaf/types"
  ]
}
