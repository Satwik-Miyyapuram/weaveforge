  "scripts": {
    "copy:pdf-worker": "node scripts/copy-pdf-worker.mjs",
    "predev": "npm run copy:pdf-worker",
    "dev": "next dev",
    "dev:clean": "npm run clean && next dev",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "serve": "next dev -p 3000",
    "prebuild": "npm run copy:pdf-worker",
    "build": "next build",
    "analyze": "node ./scripts/analyze.mjs",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:integration": "node ./scripts/run-integration-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "record:demos": "tsx e2e/demo-clips/record.ts"
  },
  "dependencies": {
