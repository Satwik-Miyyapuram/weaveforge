  "scripts": {
    "copy:pdf-worker": "node scripts/copy-pdf-worker.mjs",
    "predev": "npm run copy:pdf-worker && npm run build:embedding-worker",
    "dev": "next dev --webpack",
    "dev:clean": "npm run clean && next dev --webpack",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "serve": "next dev --webpack -p 3000",
    "prebuild": "npm run copy:pdf-worker && npm run build:embedding-worker",
    "build": "next build --webpack",
    "analyze": "node ./scripts/analyze.mjs",
    "check:contrast": "node scripts/contrast-audit.mjs",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node ./scripts/run-tests.mjs",
    "test:memory": "node ./scripts/run-tests.mjs src/features/ink/test/use-pen-capture-leak.test.tsx",
    "test:integration": "node ./scripts/run-integration-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:editor": "node ./scripts/run-editor-e2e.mjs",
    "test:e2e:design": "node ./scripts/run-design-guards.mjs",
    "test:e2e:install": "playwright install chromium",
    "record:demos": "tsx e2e/demo-clips/record.ts",
    "migrate": "./scripts/migrate-to-oracle.sh",
    "build:embedding-worker": "node scripts/build-embedding-worker.mjs"
  },
